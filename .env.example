# ============================================================================
# FastChu 配置示例。复制成 .env 后按需修改。
#
# FastChu 只查歌，全部数据来自落雪查分器的**公共接口**，
# 所以这里没有任何密钥项——不配置也能直接跑。
# 本文件不要提交（已在 .gitignore 中）。
# ============================================================================

# ---------------------------------------------------------------------------
# NoneBot 自身
# ---------------------------------------------------------------------------
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
# 管理员 QQ（不受查询冷却限制），多个用逗号分隔
SUPERUSERS=[]
COMMAND_START=["/"]
COMMAND_SEP=["."]

# 正向连接 NapCat 时打开（默认走反向 WS，不需要）
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 接口地址
# ---------------------------------------------------------------------------
FASTCHU_LXNS_BASE_URL=https://maimai.lxns.net/api/v0
# 游戏资源（曲绘）地址。官方提示访问频率有限制，请勿频繁请求。
FASTCHU_ASSETS_BASE_URL=https://assets2.lxns.net/chunithm
FASTCHU_HTTP_TIMEOUT=15
FASTCHU_HTTP_RETRIES=2

# ---------------------------------------------------------------------------
# 落雪账号绑定（OAuth 2.0 + PKCE，可选）
#
# 在落雪创建 OAuth 应用时**不要填回调地址**（无回调模式），权限勾选
# read_player。用户发 /授权 拿到链接，登录并同意后把页面显示的一次性
# 授权码发回机器人即可；机器人只保存 OAuth 令牌，不接触账号密码。
#
# 不配置也能正常查歌/查称号，只是不显示个人成绩与称号获得情况。
# Client Secret 只在公共客户端需要时填写；不要提交到仓库、不要发到群里。
# ---------------------------------------------------------------------------
FASTCHU_OAUTH_ENABLED=true
FASTCHU_LXNS_OAUTH_CLIENT_ID=
FASTCHU_LXNS_OAUTH_CLIENT_SECRET=
FASTCHU_LXNS_OAUTH_SCOPES=read_player
# 授权记录（含访问/刷新令牌）。该目录已在 .gitignore 中，请勿外传。
FASTCHU_LXNS_OAUTH_TOKEN_PATH=data/auth/oauth_tokens.json
# 从打开授权链接到提交授权码的最长等待（秒）
FASTCHU_LXNS_OAUTH_PENDING_TTL=600
# 个人成绩 / 已获得称号的缓存（秒），避免每次查歌都请求落雪
FASTCHU_PERSONAL_SCORE_TTL=300
FASTCHU_PERSONAL_TITLE_TTL=600
# 个人数据请求超时（秒）；超时只跳过个人数据，不影响基础查询
FASTCHU_PERSONAL_TIMEOUT=8

# ---------------------------------------------------------------------------
# 曲库与称号缓存（称号列表约 3.8 MB，含全部获得条件）
# ---------------------------------------------------------------------------
FASTCHU_SONG_CACHE_PATH=data/cache/song_list.json
FASTCHU_ALIAS_CACHE_PATH=data/cache/alias_list.json
FASTCHU_TROPHY_CACHE_PATH=data/cache/trophy_list.json
# 国服/日服并集（含两服定数对照）。文件不存在时不做定数双标，查歌照常。
FASTCHU_REGION_CACHE_PATH=data/songs/songs.union.json
# 缓存有效期（秒）。曲库只在版本更新时才变，一天一刷足够。
FASTCHU_SONG_CACHE_TTL=86400
FASTCHU_ALLOW_STALE_CACHE=true
# 是否拉取物量（曲目详情里的物量行需要）。关闭后响应小很多，但详情不含物量。
FASTCHU_FETCH_NOTES=true

# ---------------------------------------------------------------------------
# 输出（FastChu 追求轻量）
# ---------------------------------------------------------------------------
# 同一用户两次查询的最小间隔（秒），避免刷屏
FASTCHU_QUERY_COOLDOWN=3
# 单条消息最大长度；筛选结果超长会按行分条发送
FASTCHU_MAX_MESSAGE_LENGTH=1800
# 搜歌命中多首时最多展示几条候选
FASTCHU_SEARCH_RESULT_LIMIT=8
# 筛选结果最多展示几条
FASTCHU_FILTER_RESULT_LIMIT=30
# 曲目详情里是否带物量行
# 详情物量：off 取消 / compact 简洁（只给总物量）/ full 完整（带分项）
FASTCHU_NOTES_MODE=compact
# 曲目详情里最多列出几个相关特殊称号（每个称号占一行：颜色 + 条件）
FASTCHU_RELATED_TITLE_LIMIT=8

# ---------------------------------------------------------------------------
# 曲绘
#   url    = 把资源地址交给 OneBot 实现自行下载（默认，最轻量：机器人侧零下载零缓存）
#   base64 = 下载并本地缓存后内联发送（OneBot 实现访问不了外网时用；消息体积会涨约 1/3）
#   off    = 只发文字
# ---------------------------------------------------------------------------
FASTCHU_JACKET_MODE=url
FASTCHU_JACKET_CACHE_DIR=data/assets/jacket
FASTCHU_JACKET_MAX_BYTES=4000000
